generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Preferences {
  id String @id @default(cuid())
  telegramId String @unique

  activeOpencodeId String? @unique

  activeAgentId String @unique
  activeAgent Agent @relation(fields: [activeAgentId], references: [id])
}

model Context {
  id         String @id @default(cuid())
  openCodeId String @unique
  name       String?
}

model AiModel {
  id            String   @id @default(cuid())
  displayName   String
  referenceName String
  providerId    String

  agents   Agent[]
  provider Provider @relation(fields: [providerId], references: [id])
}

model Provider {
  id            String    @id @default(cuid())
  displayName   String
  referenceName String

  models AiModel[]
}

model Agent {
  id             String  @id @default(cuid())
  name           String  @unique
  systemPromptId String
  ocrPromptId    String?
  modelId        String
  imageSupport   Boolean

  systemPrompt Prompt  @relation("SystemPrompt", fields: [systemPromptId], references: [id])
  ocrPrompt    Prompt? @relation("OcrPrompt", fields: [ocrPromptId], references: [id])
  model        AiModel @relation(fields: [modelId], references: [id])

  preferences Preferences?
}

model Prompt {
  id      String @id @default(cuid())
  name    String @unique
  command String @unique
  prompt  String

  systemAgents Agent[] @relation("SystemPrompt")
  ocrAgents    Agent[] @relation("OcrPrompt")
}
